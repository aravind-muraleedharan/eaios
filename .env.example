# EAIOS environment configuration
#
# Copy this file to .env and adjust the values for your machine.
# Never commit .env: it may contain secrets.

# --- Application ---
EAIOS_ENVIRONMENT=development   # development | staging | production
EAIOS_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# --- Claude ---
EAIOS_ANTHROPIC_API_KEY=your_api_key
EAIOS_CLAUDE_MODEL=claude-haiku-5-5

# --- Chat ---
EAIOS_CHAT_MAX_QUES_CHARS=4000   # optional: maximum question length